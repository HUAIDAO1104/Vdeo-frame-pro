{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "帧选",
  "version": "0.2.0",
  "identifier": "com.huaidao.saleskitstudio",
  "build": {
    "beforeDevCommand": "npm run desktop:dev:frontend",
    "devUrl": "http://127.0.0.1:1420/app.html",
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "帧选 · 视频图片工作台",
        "width": 1500,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPLOCALDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "视频封面与详情图工作台",
    "longDescription": "批量提取视频画面，生成封面和详情图片，支持暂停、停止和边生成边编辑。"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMTlGODY4NzU0RTY4MjIKUldRaWFFNTFhUGdaWDJ5bjVlME05TXJjQ0pTTzhlNmU0VUdvREczVlduZ1huNTYzVlZPUmV5dloK",
      "endpoints": [
        "https://github.com/HUAIDAO1104/Vdeo-frame-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
