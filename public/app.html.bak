// -------- 本地算法：Laplacian + 亮度 + 饱和度 --------
function aiAnalyzeFrame(dataUrl){
  return new Promise(resolve=>{
    const img=new Image();
    img.onload=()=>{
      const SZ=64;
      const c=document.createElement('canvas'); c.width=SZ; c.height=Math.round(SZ*img.height/img.width)||36;
      const ctx=c.getContext('2d'); ctx.drawImage(img,0,0,c.width,c.height);
      const data=ctx.getImageData(0,0,c.width,c.height).data;
      const n=data.length/4;
      const lums=new Float32Array(n);
      let sumL=0, sumR=0, sumG=0, sumB=0;
      for(let i=0;i<n;i++){
        const r=data[i*4], g=data[i*4+1], b=data[i*4+2];
        const lum=0.299*r+0.587*g+0.114*b;
        lums[i]=lum; sumL+=lum; sumR+=r; sumG+=g; sumB+=b;
      }
      const meanL=sumL/n;
      const meanR=sumR/n, meanG=sumG/n, meanB=sumB/n;
      const W=c.width, H=c.height;
      let lapVar=0, lapCnt=0;
      for(let y=1;y<H-1;y++){
        for(let x=1;x<W-1;x++){
          const idx=y*W+x;
          const lap=Math.abs(-lums[idx-W-1]-lums[idx-W]-lums[idx-W+1]
                             -lums[idx-1]+8*lums[idx]-lums[idx+1]
                             -lums[idx+W-1]-lums[idx+W]-lums[idx+W+1]);
          lapVar+=lap; lapCnt++;
        }
      }
      const sharpness=lapCnt>0?(lapVar/lapCnt):0;
      const brightScore=1-Math.abs(meanL-125)/125;
      const maxC=Math.max(meanR,meanG,meanB), minC=Math.min(meanR,meanG,meanB);
      const saturation=maxC>0?(maxC-minC)/maxC:0;
      const thumbUrl=c.toDataURL('image/jpeg',.4);
      resolve({sharpness, brightScore:Math.max(0,brightScore), saturation, thumbUrl, meanLum:meanL});
    };
    img.onerror=()=>resolve({sharpness:0,brightScore:0,saturation:0,thumbUrl:'',meanLum:0});
    img.src=dataUrl;
  });
}

// -------- Vision API：压缩帧 → base64 → 批量评分 --------
// 压缩到 256×144 (16:9)，满足模型最小10px要求，体积约8-15KB
function compressFrameForVision(dataUrl){
  return new Promise(resolve=>{
    const img=new Image();
    img.onload=()=>{
      const c=document.createElement('canvas');
      c.width=256; c.height=144;
      const ctx=c.getContext('2d');
      const ar=img.width/img.height;
      let sx=0,sy=0,sw=img.width,sh=img.height;
      if(ar>16/9){ sw=Math.round(img.height*(16/9)); sx=(img.width-sw)/2; }
      else       { sh=Math.round(img.width/(16/9));  sy=(img.height-sh)/2; }
      ctx.drawImage(img,sx,sy,sw,sh,0,0,256,144);
      const dataURL=c.toDataURL('image/jpeg',0.75);
      const b64=dataURL.split(',')[1];
      resolve(b64 && b64.length>100 ? b64 : null);
    };
    img.onerror=()=>resolve(null);
    img.src=dataUrl;
  });
}

// 单批次调用 Vision API，frames = [{frameIdx, b64}]（b64必须非null）
// 返回 [{frameIdx, clarity, composition, appeal, overall}]
// goodRefImages / badRefImages：base64 数组（不含 data: 前缀），AI 会直接看见这些参考图
async function visionScoreBatch(frames, apiKey, model, hintText, goodRefImages=[], badRefImages=[]){
  // skip frames where compression failed
  const validFrames = frames.filter(f => f.b64);
  if(validFrames.length === 0) return [];

  const hint = hintText ? (hintText + ' ') : '';

  // build example to guide model output format
  const exampleScores = validFrames.map((_,i)=>
    '{"idx":'+(i+1)+',"clarity":8,"composition":7,"appeal":6,"overall":7}'
  ).join(',');

  const contentParts = [];

  // ── 如有参考图，先插入参考图块 ──
  let refBlock = '';
  if(goodRefImages.length > 0){
    refBlock += '【用户喜欢的参考图风格，请学习以下'+goodRefImages.length+'张图的构图、色调、主题，在候选帧中优先选出同类型的帧】\n';
  }
  if(badRefImages.length > 0){
    refBlock += '【用户不喜欢的参考图风格，请回避与以下'+badRefImages.length+'张图相似的候选帧】\n';
  }

  const systemText =
    '你是专业视频封面图质量评审 AI。\n'+
    (refBlock ? refBlock+'\n' : '')+
    hint+
    '下面将提供'+validFrames.length+'张候选视频截图（每张前有【候选图N】标记）。\n'+
    '请对每张候选图从以下4个维度打分（0-10整数）：\n'+
    '1. clarity（清晰度/对焦/画面锐利程度）\n'+
    '2. composition（构图/画面平衡/主体突出度）\n'+
    '3. appeal（视觉吸引力/色彩表现/情绪感染力）\n'+
    '4. overall（综合推荐分，是否适合作视频封面/缩略图'+(goodRefImages.length?'，参考用户偏好风格':'')+'）\n\n'+
    '每张图必须分别给出独立评分，共输出'+validFrames.length+'个评分对象。\n'+
    '严格只输出纯JSON，不要任何说明，不要代码块：\n'+
    '{"scores":['+exampleScores+']}';

  contentParts.push({ type:'text', text: systemText });

  // 插入好图参考图
  goodRefImages.forEach((b64, i)=>{
    contentParts.push({ type:'text', text:'【用户喜欢的参考图 '+(i+1)+'】' });
    contentParts.push({ type:'image_url', image_url:{ url:'data:image/jpeg;base64,'+b64, detail:'low' } });
  });
  // 插入坏图参考图
  badRefImages.forEach((b64, i)=>{
    contentParts.push({ type:'text', text:'【用户不喜欢的参考图 '+(i+1)+'】' });
    contentParts.push({ type:'image_url', image_url:{ url:'data:image/jpeg;base64,'+b64, detail:'low' } });
  });

  // 插入候选帧
  if(goodRefImages.length + badRefImages.length > 0){
    contentParts.push({ type:'text', text:'──以下是候选帧，请按照上面参考图的偏好标准进行评分──' });
  }
  validFrames.forEach((f,i)=>{
    contentParts.push({type:'text', text:'【候选图'+(i+1)+'】'});
    contentParts.push({
      type:'image_url',
      image_url:{url:'data:image/jpeg;base64,'+f.b64, detail:'low'}
    });
  });

  const resp = await fetch('https://llm-api.mcisaas.com/v1/chat/completions',{
    method:'POST',
    headers:{
      'Content-Type':'application/json',
      'Authorization':'Bearer '+apiKey
    },
    body: JSON.stringify({
      model,
      messages:[{role:'user', content:contentParts}],
      max_tokens: 800,
      temperature: 0
    })
  });

  if(!resp.ok){
    const errText = await resp.text();
    throw new Error('API错误 '+resp.status+': '+errText.slice(0,300));
  }

  const json = await resp.json();
  const raw  = (json.choices?.[0]?.message?.content || '').trim();
  if(!raw) throw new Error('AI返回空响应，请检查模型或API余额');

  // robust JSON parse: handle raw / markdown wrapped / prefixed responses
  let parsed = null;
  // try direct parse
  try { parsed = JSON.parse(raw); } catch(_){}
  // fallback: extract JSON by finding first { and last }
  if(!parsed || !parsed.scores){
    const jsonStart = raw.indexOf('{');
    const jsonEnd   = raw.lastIndexOf('}');
    if(jsonStart >= 0 && jsonEnd > jsonStart){
      try{ parsed = JSON.parse(raw.slice(jsonStart, jsonEnd+1)); }catch(_){}
    }
  }
  if(!parsed || !Array.isArray(parsed.scores)){
    throw new Error('AI返回格式无法解析：'+raw.slice(0,300));
  }

  // map by position i, not AI-returned idx
  const results = [];
  for(let i = 0; i < validFrames.length; i++){
    const s = parsed.scores[i];
    if(!s) continue;
    results.push({
      frameIdx    : validFrames[i].frameIdx,
      clarity     : Math.max(0, Math.min(10, Number(s.clarity)     || 5)) / 10,
      composition : Math.max(0, Math.min(10, Number(s.composition) || 5)) / 10,
      appeal      : Math.max(0, Math.min(10, Number(s.appeal)      || 5)) / 10,
      overall     : Math.max(0, Math.min(10, Number(s.overall)     || 5)) / 10,
    });
  }
  return results;
}

// -------- 进度条辅助 --------
function setAiProgress(pct, label){
  const wrap  = document.getElementById('aiProgress');
  const fill  = document.getElementById('aiProgFill');
  const lbl   = document.getElementById('aiProgLabel');
  const num   = document.getElementById('aiProgNum');
  if(pct < 0){ wrap.style.display='none'; return; }
  wrap.style.display = '';
  fill.style.width   = pct.toFixed(0)+'%';
  lbl.textContent    = label || '分析中...';
  num.textContent    = pct.toFixed(0)+'%';
}

// -------- 通用：像素差计算（用于多样性筛选）--------
async function buildPixCache(frameIndices, getThumbFn){
  const cache={};
  for(const idx of frameIndices){
    cache[idx] = await new Promise(r=>{
      const img=new Image();
      img.onload=()=>{
        const c=document.createElement('canvas'); c.width=16; c.height=9;
        c.getContext('2d').drawImage(img,0,0,16,9);
        r(c.getContext('2d').getImageData(0,0,16,9).data);
      };
      img.onerror=()=>r(null);
      img.src = getThumbFn(idx);
    });
    await sleep(0);
  }
  return cache;
}
function pixDiff(pA, pB){
  if(!pA||!pB) return 1;
  let d=0;
  for(let i=0;i<pA.length;i+=4)
    d+=Math.abs(pA[i]-pB[i])+Math.abs(pA[i+1]-pB[i+1])+Math.abs(pA[i+2]-pB[i+2]);
  return d/(16*9*3*255);
}

// -------- 贪心多样性筛选（通用） --------
// 策略：第1帧选最高质量分；后续帧取 质量×0.55 + 与已选最小差异×0.45
// 相似度惩罚：若与已选某帧像素差 < 阈值，视为重复帧，大幅降权
function greedyDiversePick(scored, N, pixCache){
  if(!scored.length) return [];
  const SIM_THRESHOLD = 0.06; // 像素差低于此值 = 高度相似（重复帧）
  const selected = [];
  const remaining = [...scored].sort((a,b) => b.score - a.score);

  // 第一帧：直接选最高质量分
  selected.push(remaining.shift());

  // 后续帧：贪心 composite
  while(selected.length < N && remaining.length){
    remaining.forEach(s => {
      const diffs = selected.map(sel => pixDiff(pixCache[s.frameIdx], pixCache[sel.frameIdx]));
      const minDiff = Math.min(...diffs);
      // 高度相似惩罚：minDiff越小惩罚越重
      const penalty = minDiff < SIM_THRESHOLD
        ? Math.pow(minDiff / SIM_THRESHOLD, 1.5)  // 0~1，越相似越趋向0
        : 1.0;
      s.composite = (s.score * 0.55 + minDiff * 0.45) * penalty;
    });
    remaining.sort((a,b) => b.composite - a.composite);
    selected.push(remaining.shift());
  }
  return selected;
}

// -------- 本地算法降级 --------
async function runLocalPick(N){
  const analyses=[];
  for(let i=0;i<S.frames.length;i++){
    const r=await aiAnalyzeFrame(S.frames[i].dataUrl);
    analyses.push({...r, frameIdx:i});
    if(i%10===0) await sleep(0);
  }
  S.aiScores=analyses;
  const maxSharp=Math.max(...analyses.map(a=>a.sharpness))||1;
  analyses.forEach(a=>{ a.sharpNorm=a.sharpness/maxSharp; });

  // 像素缓存（用Map避免数组位置偏移问题）
  const thumbMap = {};
  analyses.forEach(a => { thumbMap[a.frameIdx] = a.thumbUrl; });
  const pixCache = await buildPixCache(
    analyses.map(a => a.frameIdx),
    idx => thumbMap[idx]
  );

  // 将本地分数合并为单一 score
  analyses.forEach(a=>{
    a.score = a.sharpNorm*0.50 + a.brightScore*0.25 + a.saturation*0.25;
  });

  const selected = greedyDiversePick(analyses, N, pixCache);

  // 更新评分标签 → 本地维度
  document.getElementById('sl-sharp').textContent  = '清晰度';
  document.getElementById('sl-bright').textContent = '亮度';
  document.getElementById('sl-sat').textContent    = '饱和度';
  document.getElementById('sl-diff').textContent   = '差异性';
  document.getElementById('aiScoresTitle').textContent = '最高分帧（本地算法）';
  document.getElementById('aiScoresMode').textContent  = '📐 LOCAL';

  if(selected[0]){
    const top=selected[0];
    document.getElementById('aiScores').style.display='block';
    const setBar=(id,v)=>{
      document.getElementById('sc-'+id).style.width=(v*100).toFixed(0)+'%';
      document.getElementById('sv-'+id).textContent=(v*100).toFixed(0);
    };
    setBar('sharp', top.sharpNorm);
    setBar('bright', top.brightScore);
    setBar('sat',   top.saturation);
    const avgDiv=selected.slice(1).reduce((s,a)=>s+a.composite,0)/Math.max(1,selected.length-1);
    setBar('diff', avgDiv);
  }

  return { indices: selected.map(a=>a.frameIdx).sort((a,b)=>a-b), mode:'local' };
}

// -------- Vision AI 主流程 --------
async function runVisionPick(N, apiKey, model, hintText){
  // ── 获取审美记忆：好图/坏图 base64 + 文字描述 ──
  const prefCtx = await buildPrefContext();
  if(prefCtx.hintText) hintText = (hintText ? hintText + '。' : '') + prefCtx.hintText;
  const goodRefImages = prefCtx.goodImages;  // 直接传给 AI 看的参考好图
  const badRefImages  = prefCtx.badImages;   // 直接传给 AI 看的参考坏图
  if(goodRefImages.length + badRefImages.length > 0){
    toast('🧠 已加载 '+goodRefImages.length+' 张偏好参考图发给AI学习...', 'info');
  }
  // sample up to 60 frames evenly to avoid timeout
  const MAX_SEND = 60;
  const total = S.frames.length;
  let sendIndices;
  if(total <= MAX_SEND){
    sendIndices = Array.from({length:total}, (_,i) => i);
  } else {
    sendIndices = [];
    for(let i=0;i<MAX_SEND;i++) sendIndices.push(Math.round(i*(total-1)/(MAX_SEND-1)));
    sendIndices = [...new Set(sendIndices)];
  }

  // Step1: compress sampled frames
  setAiProgress(0, '正在压缩帧（共'+sendIndices.length+'帧）...');
  const compressed = [];
  for(let j=0; j<sendIndices.length; j++){
    const fi = sendIndices[j];
    const b64 = await compressFrameForVision(S.frames[fi].dataUrl);
    if(b64) compressed.push({frameIdx:fi, b64});
    if(j%5===0) setAiProgress(j/sendIndices.length*28, '压缩帧 '+(j+1)+'/'+sendIndices.length);
    await sleep(0);
  }
  if(compressed.length === 0) throw new Error('所有帧压缩失败，请检查视频帧数据');

  // Step2: score in batches of 4
  const BATCH = 4;
  const allScores = [];
  const batches = [];
  for(let i=0; i<compressed.length; i+=BATCH) batches.push(compressed.slice(i, i+BATCH));

  for(let bi=0; bi<batches.length; bi++){
    setAiProgress(28 + (bi/batches.length)*62, 'AI 评分 '+(bi+1)+'/'+batches.length+' 批...');
    try {
      // 仅第一批次传入参考图（避免每批都带大量图片增加 token）
      const refGood = bi===0 ? goodRefImages : [];
      const refBad  = bi===0 ? badRefImages  : [];
      const scores = await visionScoreBatch(batches[bi], apiKey, model, hintText, refGood, refBad);
      allScores.push(...scores);
    } catch(batchErr){
      // on batch failure, fill with neutral scores
      console.warn('批次'+(bi+1)+'评分失败:', batchErr.message);
      for(const f of batches[bi]){
        allScores.push({frameIdx:f.frameIdx, clarity:0.5, composition:0.5, appeal:0.5, overall:0.5});
      }
    }
    await sleep(80); // rate limit pause
  }

  if(allScores.length === 0) throw new Error('All batches failed. Check API key and balance.');
  setAiProgress(92, '计算多样性...');

  // Step3: 使用动态自适应权重合并评分（权重由用户历史点赞图特征决定）
  const w = _adaptiveWeights;
  allScores.forEach(s => {
    s.score = s.overall*w.overall + s.clarity*w.clarity + s.composition*w.composition + s.appeal*w.appeal;
  });

  // Step4: build pixel diversity cache using compressed b64
  const b64Map = {};
  compressed.forEach(f => { b64Map[f.frameIdx] = 'data:image/jpeg;base64,'+f.b64; });
  const pixCache = await buildPixCache(
    allScores.map(s => s.frameIdx),
    idx => b64Map[idx] || S.frames[idx]?.dataUrl
  );
  setAiProgress(97, '挑选最优帧...');

  const selected = greedyDiversePick(allScores, N, pixCache);
  S.aiScores = allScores;
  setAiProgress(-1);
  return { indices: selected.map(s=>s.frameIdx), mode: 'vision' };
}

// -------- 主入口 --------
async function runAIPick(autoFill=false){
  if(S.frames.length===0){ toast('请先截取视频帧','err'); return; }
  const N   = Math.min(parseInt(document.getElementById('aiN').value)||15, S.frames.length);
  const btn = document.getElementById('aiPickBtn');
  const btn2= document.getElementById('aiAutoFillBtn');
  const starSVG='<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:4px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';

  btn.innerHTML='<span class="spin"></span>分析中...'; btn.disabled=true; btn2.disabled=true;

  const apiKey  = document.getElementById('aiApiKey').value.trim();
  const model   = document.getElementById('aiModel').value;
  const hint    = document.getElementById('aiPromptHint').value.trim();

  let result;

  if(apiKey){
    // 优先尝试 Vision AI
    try {
      result = await runVisionPick(N, apiKey, model, hint);
      toast('✨ Vision AI（'+model.split('-').slice(0,3).join('-')+'）挑选出 '+result.indices.length+' 帧');
    } catch(err){
      setAiProgress(-1);
      // 自动降级本地算法
      toast('⚠️ Vision AI 失败（'+err.message.slice(0,40)+'），已切换本地算法', 'warn');
      try {
        result = await runLocalPick(N);
        toast('📐 本地算法已挑选出 '+result.indices.length+' 帧');
      } catch(e2){
        toast('挑帧失败：'+e2.message,'err');
        btn.innerHTML=starSVG+'AI 自动挑帧'; btn.disabled=false; btn2.disabled=false;
        return;
      }
    }
  } else {
    // 无 Key → 直接本地算法
    try {
      result = await runLocalPick(N);
      toast('📐 本地算法已挑选出 '+result.indices.length+' 帧（填入 API Key 可使用 Vision AI）');
    } catch(e){
      toast('挑帧失败：'+e.message,'err');
      btn.innerHTML=starSVG+'AI 自动挑帧'; btn.disabled=false; btn2.disabled=false;
      return;
    }
  }

  // 更新选中状态
  S.selected = result.indices;
  renderSel(); updateSelBadge(); updateFillBtn(); updateDlBtns();

  // 标记徽章
  document.querySelectorAll('.ai-top-badge').forEach(el=>el.remove());
  result.indices.forEach((fi,rank)=>{
    const el=document.getElementById('fGrid').querySelector('[data-fi="'+fi+'"]');
    if(el){
      const badge=document.createElement('div');
      badge.className='ai-top-badge';
      badge.innerHTML=(result.mode==='vision'?'🤖':'★')+' #'+(rank+1);
      el.appendChild(badge);
    }
  });

  btn.innerHTML=starSVG+'AI 自动挑帧'; btn.disabled=false; btn2.disabled=false;
  updateQuickBar();

  // 自动给 AI 选中的帧挂载反馈按钮（async，fire-and-forget）
  result.indices.forEach(fi=>{
    const el = document.getElementById('fGrid').querySelector('[data-fi="'+fi+'"]');
    if(el) addFeedbackBtns(fi, el).catch(()=>{});
  });

  // 自动切到填充拼图 Tab（除非已是 autoFill 或一键流程中）
  if(!autoFill && !S._superFlowRunning){
    setTimeout(()=>switchTab(2), 600);
  }

  if(autoFill && S.batches.length>0){
    let fi=0;
    S.batches.forEach(b=>{
      b.cells.forEach((_,ci)=>{
        if(fi<S.selected.length){ b.cells[ci]=S.selected[fi++]; renderCell(b,ci); }
      });
    });
    refreshUsageTags();
    toast('AI 挑帧完成，已自动填入 '+fi+' 个格子');
  }
}

document.getElementById('aiPickBtn').addEventListener('click', ()=>runAIPick(false));
document.getElementById('aiAutoFillBtn').addEventListener('click', ()=>runAIPick(true));

// ===================================================================
// BATCHES
// ===================================================================
function promptCustomBatch(){
  const input=prompt('输入行×列 (例: 2×3 或 4 4)','3×4');
  if(!input) return;
  const m=input.match(/(\d+)[x×,\s]+(\d+)/i);
  if(m){ addBatch(parseInt(m[1]),parseInt(m[2])); }
  else toast('格式有误，请输入如 3×4','err');
}

function addBatch(cols,rows){
  const id=++batchIdCnt;
  const total=cols*rows;
  const batch={id, cols, rows, cells:Array(total).fill(null), hasBadge:(cols===2&&rows===2), canvas:null};
  S.batches.push(batch);
  document.getElementById('batchEmpty').style.display='none';
  renderBatch(batch);
  updateFillBtn();
  updateQuickBar();
  toast('已添加 '+cols+'×'+rows+' 拼图批次 #'+id);
}

function renderBatch(b){
  const el=document.createElement('div');
  el.className='batch'; el.id='batch-'+b.id;
  el.innerHTML=batchHTML(b);
  document.getElementById('batchList').appendChild(el);
  initBatchEvents(el,b);
  // bind preview click
  const prev=el.querySelector('.prev-thumb');
  if(prev) prev.addEventListener('click', ()=>openPreviewModal(b));
}

function batchHTML(b){
  return (
    // ── 顶部：标题 + 操作按钮 ──
    '<div class="batch-head">'+
    '  <div class="batch-title">'+
    '    <span class="batch-tag">'+b.cols+'×'+b.rows+'</span>'+
    '    <span style="color:var(--tm);font-size:9px;">批次 #'+b.id+'</span>'+
    '  </div>'+
    '  <div class="batch-actions">'+
    '    <button class="btn-sm" onclick="downloadBatch('+b.id+')" id="dl-'+b.id+'" disabled>'+
    '      <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>下载'+
    '    </button>'+
    '    <button class="btn-del" onclick="removeBatch('+b.id+')">删除</button>'+
    '  </div>'+
    '</div>'+
    // ── 拼图格子（全宽） ──
    '<div class="collage-grid" id="cgrid-'+b.id+'"'+
    '     style="grid-template-columns:repeat('+b.cols+',1fr);grid-template-rows:repeat('+b.rows+',1fr);">'+
    '  '+Array.from({length:b.cols*b.rows},(_,i)=>cellHTML(b,i)).join('')+
    '</div>'+
    // ── 预览图（生成后显示，全宽大图） ──
    '<div class="prev-thumb" id="prev-'+b.id+'" title="点击全屏预览"><canvas id="pcanvas-'+b.id+'"></canvas></div>'+
    // ── 底部工具栏：横向紧凑排列 ──
    '<div class="batch-side">'+
    '  <div class="side-section">'+
    '    <span style="font-size:8px;color:var(--tm);white-space:nowrap;">尺寸</span>'+
    '    <input type="number" class="gs-inp" id="gc-'+b.id+'" value="'+b.cols+'" min="1" max="10" style="width:36px;"/>'+
    '    <span class="gs-x">×</span>'+
    '    <input type="number" class="gs-inp" id="gr-'+b.id+'" value="'+b.rows+'" min="1" max="10" style="width:36px;"/>'+
    '    <button class="btn-apply" onclick="resizeBatch('+b.id+')" style="white-space:nowrap;">应用</button>'+
    '  </div>'+
    '  <div class="side-section">'+
    '    <span style="font-size:8px;color:var(--tp);white-space:nowrap;">4K角标</span>'+
    '    <label class="tog" style="margin:0;">'+
    '      <input type="checkbox" id="badge-'+b.id+'" '+(b.hasBadge?'checked':'')+' />'+
    '      <div class="tog-track"></div>'+
    '      <div class="tog-thumb"></div>'+
    '    </label>'+
    '  </div>'+
    '  <button class="btn-gen" onclick="generateBatch('+b.id+')" id="gen-'+b.id+'" style="flex:1;min-width:80px;">生成拼图</button>'+
    '  <button class="btn-dl" onclick="downloadBatch('+b.id+')" id="dl2-'+b.id+'" disabled style="flex:1;min-width:80px;">'+
    '    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>下载 1080P'+
    '  </button>'+
    '</div>'
  );
}

function cellHTML(b,i){
  const hasImg = b.cells[i]!==null;
  const f = hasImg ? S.frames[b.cells[i]] : null;
  return '<div class="cell '+(hasImg?'has-img':'')+'" id="cell-'+b.id+'-'+i+'" data-bid="'+b.id+'" data-ci="'+i+'">'+
    (hasImg
      ? '<img src="'+f.dataUrl+'"/>'+
        '<div class="cell-remove" onclick="removeCell('+b.id+','+i+');event.stopPropagation();">\xd7</div>'+
        '<div class="cell-replace-hint">\u70b9\u51fb\u66ff\u6362</div>'
      : '<div class="cell-ph"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>\u70b9\u51fb/\u62d6\u5165</span></div>'
    )+
    '<div class="cell-num">'+(i+1)+'</div>'+
  '</div>';
}

function initBatchEvents(el, b){
  el.querySelectorAll('.cell').forEach(cell=>{
    const ci=parseInt(cell.dataset.ci);
    // ALL cells (empty + has-img) trigger picker on click
    cell.onclick = e=>{
      if(e.target.closest('.cell-remove')) return;
      pickFrame(b, ci);
    };
    bindDropEvents(cell, b, ci);
  });
}

function bindDropEvents(cell, b, ci){
  cell.ondragover = e=>{
    if(S.dragFrameIdx!==null){ e.preventDefault(); cell.classList.add('drop-target'); }
  };
  cell.ondragleave = ()=>cell.classList.remove('drop-target');
  cell.ondrop = e=>{
    e.preventDefault(); cell.classList.remove('drop-target');
    if(S.dragFrameIdx!==null){
      b.cells[ci]=S.dragFrameIdx; renderCell(b,ci); clearBatchCanvas(b);
      refreshUsageTags();
    }
  };
}

function clearDropTargets(){
  document.querySelectorAll('.cell.drop-target').forEach(c=>c.classList.remove('drop-target'));
}

// ===================================================================
// FRAME PICKER (modal)
// ===================================================================
function pickFrame(b, ci){
  if(S.frames.length===0){ toast('请先截取视频帧','err'); return; }
  showFramePicker(b, ci);
}

function showFramePicker(b, ci){
  document.getElementById('framePicker')?.remove();
  const current = b.cells[ci];
  const picker = document.createElement('div');
  picker.id='framePicker';
  Object.assign(picker.style,{
    position:'fixed',inset:'0',zIndex:'888',
    background:'rgba(0,0,0,0.7)',backdropFilter:'blur(6px)',
    display:'flex',alignItems:'center',justifyContent:'center',
  });
  picker.innerHTML=
    '<div style="background:var(--card2);border:1px solid var(--bs);border-radius:14px;'+
    'padding:20px;max-width:820px;width:92%;max-height:85vh;'+
    'display:flex;flex-direction:column;gap:12px;box-shadow:0 24px 80px rgba(0,0,0,.7);">'+
    '<div style="display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">'+
    '<span style="font-size:13px;font-weight:600;color:var(--mint-light);">'+
    '选择帧 → 格子 #'+(ci+1)+'（批次 #'+b.id+'）'+
    (current!==null?'<span style="font-size:10px;color:var(--tm);">当前: 第'+(current+1)+'帧</span>':'')+
    '</span>'+
    '<div style="display:flex;gap:8px;align-items:center;">'+
    (current!==null?'<button onclick="removeCell('+b.id+','+ci+');document.getElementById(\'framePicker\').remove();" style="padding:4px 10px;background:transparent;border:1px solid rgba(255,80,80,0.3);border-radius:6px;color:rgba(255,100,100,0.8);font-size:10px;cursor:pointer;">清除此格</button>':'')+
    '<button onclick="document.getElementById(\'framePicker\').remove()" style="background:transparent;border:none;color:var(--tm);font-size:20px;cursor:pointer;width:28px;height:28px;display:flex;align-items:center;justify-content:center;">×</button>'+
    '</div></div>'+
    '<div id="fpGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;overflow-y:auto;flex:1;padding-right:4px;"></div></div>';
  picker.addEventListener('click', e=>{ if(e.target===picker) picker.remove(); });
  document.body.appendChild(picker);
  const fpGrid = picker.querySelector('#fpGrid');
  renderFramePickerGrid(fpGrid, b, ci);
}

function renderFramePickerGrid(grid, b, ci){
  const CHUNK = 40;
  const total = S.frames.length;
  const selected = b.cells[ci];
  let offset = 0;

  // IntersectionObserver 懒加载，root 为弹窗容器
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(!entry.isIntersecting) return;
      const el = entry.target;
      const idx = parseInt(el.dataset.lazy);
      if(!isNaN(idx) && S.frames[idx] && !el.src){
        el.src = S.frames[idx].dataUrl;
        delete el.dataset.lazy;
      }
      io.unobserve(el);
    });
  },{root: grid, rootMargin:'300px'});

  function renderChunk(){
    const end = Math.min(offset + CHUNK, total);
    const frag = document.createDocumentFragment();
    for(let i=offset;i<end;i++){
      const f = S.frames[i];
      const sel = selected===i;
      const item = document.createElement('div');
      item.setAttribute('onclick','pickDone('+b.id+','+ci+','+i+')');
      // 外层容器：固定宽高比 16:9，overflow:hidden 防止子元素撑破
      item.style.cssText =
        'position:relative;border-radius:7px;overflow:hidden;'+
        'border:2px solid '+(sel?'var(--mint)':'transparent')+';'+
        'cursor:pointer;background:#111;transition:border-color .15s;'+
        'aspect-ratio:16/9;width:100%;';
      // img：绝对定位填满，object-fit:cover 确保不变形、不留白
      const img = document.createElement('img');
      img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;pointer-events:none;';
      img.dataset.lazy = i; // 懒加载，不直接赋 src
      io.observe(img);
      item.appendChild(img);
      // 时间戳
      const ts = document.createElement('div');
      ts.style.cssText = 'position:absolute;bottom:2px;left:3px;font-size:8px;color:var(--mint-lighter);background:rgba(0,0,0,.75);padding:1px 4px;border-radius:3px;pointer-events:none;line-height:1.4;';
      ts.textContent = f.time.toFixed(1)+'s';
      item.appendChild(ts);
      // 序号
      const num = document.createElement('div');
      num.style.cssText = 'position:absolute;top:2px;right:3px;font-size:8px;color:var(--tm);background:rgba(0,0,0,.65);padding:1px 4px;border-radius:3px;pointer-events:none;line-height:1.4;';
      num.textContent = '#'+(i+1);
      item.appendChild(num);
      // 选中勾
      if(sel){
        const chk = document.createElement('div');
        chk.style.cssText = 'position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--mint);display:flex;align-items:center;justify-content:center;pointer-events:none;';
        chk.innerHTML = '<svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
        item.appendChild(chk);
      }
      frag.appendChild(item);
    }
    grid.appendChild(frag);
    offset = end;
    if(offset<total){
      if('requestIdleCallback' in window) window.requestIdleCallback(renderChunk, {timeout:200});
      else setTimeout(renderChunk, 16);
    }
  }
  renderChunk();
}

function pickDone(bid, ci, fi){
  document.getElementById('framePicker')?.remove();
  const b=S.batches.find(x=>x.id===bid); if(!b) return;
  b.cells[ci]=fi; renderCell(b,ci); clearBatchCanvas(b);
  refreshUsageTags();
}

function removeCell(bid, ci){
  const b=S.batches.find(x=>x.id===bid); if(!b) return;
  b.cells[ci]=null; renderCell(b,ci); clearBatchCanvas(b);
  refreshUsageTags();
}

function renderCell(b, ci){
  const cellEl=document.getElementById('cell-'+b.id+'-'+ci); if(!cellEl) return;
  const hasImg=b.cells[ci]!==null;
  const f=hasImg?S.frames[b.cells[ci]]:null;
  cellEl.className='cell '+(hasImg?'has-img':'');
  cellEl.innerHTML=hasImg
    ? '<img src="'+f.dataUrl+'"/>'+
      '<div class="cell-remove" onclick="removeCell('+b.id+','+ci+');event.stopPropagation();">×</div>'+
      '<div class="cell-replace-hint">点击替换</div>'
    : '<div class="cell-ph"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>点击/拖入</span></div>';
  cellEl.innerHTML+='<div class="cell-num">'+(ci+1)+'</div>';
  // re-bind ALL cell events (both empty and has-img)
  cellEl.onclick = e=>{
    if(e.target.closest('.cell-remove')) return;
    pickFrame(b, ci);
  };
  bindDropEvents(cellEl, b, ci);
}

function renderAllCells(b){
  b.cells.forEach((_,ci)=>renderCell(b,ci));
  clearBatchCanvas(b);
}

function clearBatchCanvas(b){
  b.canvas=null;
  const prev=document.getElementById('prev-'+b.id);
  if(prev) prev.style.display='none';
  const dlBtn=document.getElementById('dl-'+b.id);
  if(dlBtn) dlBtn.disabled=true;
  const dl2Btn=document.getElementById('dl2-'+b.id);
  if(dl2Btn) dl2Btn.disabled=true;
}

function resizeBatch(bid){
  const b=S.batches.find(x=>x.id===bid); if(!b) return;
  const nc=parseInt(document.getElementById('gc-'+bid).value)||b.cols;
  const nr=parseInt(document.getElementById('gr-'+bid).value)||b.rows;
  b.cols=Math.max(1,Math.min(10,nc)); b.rows=Math.max(1,Math.min(10,nr));
  b.cells=Array(b.cols*b.rows).fill(null);
  const grid=document.getElementById('cgrid-'+bid);
  grid.style.gridTemplateColumns='repeat('+b.cols+',1fr)';
  grid.style.gridTemplateRows='repeat('+b.rows+',1fr)';
  grid.innerHTML=Array.from({length:b.cols*b.rows},(_,i)=>cellHTML(b,i)).join('');
  // rebind
  grid.querySelectorAll('.cell').forEach(cell=>{
    const ci=parseInt(cell.dataset.ci);
    cell.onclick = e=>{ if(e.target.closest('.cell-remove')) return; pickFrame(b,ci); };
    bindDropEvents(cell, b, ci);
  });
  const tagEl=document.querySelector('#batch-'+bid+' .batch-tag');
  if(tagEl) tagEl.textContent=b.cols+'×'+b.rows;
  clearBatchCanvas(b);
  refreshUsageTags();
  toast('已调整为 '+b.cols+'×'+b.rows+' 拼图');
}

function removeBatch(bid){
  const idx=S.batches.findIndex(x=>x.id===bid); if(idx===-1) return;
  S.batches.splice(idx,1);
  document.getElementById('batch-'+bid)?.remove();
  if(S.batches.length===0) document.getElementById('batchEmpty').style.display='flex';
  updateFillBtn(); refreshUsageTags();
  toast('已删除批次 #'+bid);
}

// ===================================================================
// GENERATE
// ===================================================================
async function generateBatch(bid){
  const b=S.batches.find(x=>x.id===bid); if(!b) return;
  const filledCells=b.cells.filter(c=>c!==null);
  if(filledCells.length===0){ toast('请先为格子添加帧图像','err'); return; }

  const genBtn=document.getElementById('gen-'+bid);
  genBtn.innerHTML='<span class="spin"></span>生成中...'; genBtn.disabled=true;
  await sleep(20);

  const W=1920, H=1080;
  const canvas=document.createElement('canvas');
  canvas.width=W; canvas.height=H;
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#000'; ctx.fillRect(0,0,W,H);
  const uniqFilled = [...new Set(filledCells)];
  await Promise.all(uniqFilled.map(fi=>loadImg(S.frames[fi].dataUrl)));

  // Precise cell dimensions: last col/row gets the remainder pixels
  for(let r=0;r<b.rows;r++){
    for(let c=0;c<b.cols;c++){
      const i=r*b.cols+c;
      // Recalculate: simpler precise approach
      const x0 = Math.round(W*c/b.cols);
      const y0 = Math.round(H*r/b.rows);
      const x1 = Math.round(W*(c+1)/b.cols);
      const y1 = Math.round(H*(r+1)/b.rows);
      const cw = x1-x0, ch = y1-y0;

      const fi=b.cells[i];
      if(fi!==null){
        const img=await loadImg(S.frames[fi].dataUrl);
        if(img){
          const sc=Math.max(cw/img.width, ch/img.height);
          const sw=img.width*sc, sh=img.height*sc;
          const sx=x0+(cw-sw)/2, sy=y0+(ch-sh)/2;
          ctx.drawImage(img,sx,sy,sw,sh);
        }
      } else {
        ctx.fillStyle='#0a140f'; ctx.fillRect(x0,y0,cw,ch);
        ctx.strokeStyle='rgba(62,180,137,0.12)';ctx.lineWidth=1;
        ctx.strokeRect(x0+.5,y0+.5,cw-1,ch-1);
      }
      // Inner grid lines (between cells, no outer border)
      ctx.strokeStyle='rgba(0,0,0,0)'; ctx.lineWidth=0; // no dividers = seamless
    }
  }

  // Badge overlay: original pixel 1:1, draw at (0,0)
  const badgeChk=document.getElementById('badge-'+bid);
  if(badgeChk&&badgeChk.checked&&S.badgeImg){
    const bi=S.badgeImg;
    ctx.drawImage(bi, 0, 0, bi.naturalWidth, bi.naturalHeight);
  }

  b.canvas=canvas;

  // Show thumbnail preview
  const prevWrap=document.getElementById('prev-'+bid);
  const pcanvas=document.getElementById('pcanvas-'+bid);
  prevWrap.style.display='block';
  const pw=prevWrap.clientWidth||360;
  const ph=Math.round(pw*9/16);
  pcanvas.width=pw; pcanvas.height=ph;
  pcanvas.getContext('2d').drawImage(canvas,0,0,pw,ph);

  // Enable download buttons
  const dlBtn=document.getElementById('dl-'+bid);
  if(dlBtn) dlBtn.disabled=false;
  const dl2Btn=document.getElementById('dl2-'+bid);
  if(dl2Btn) dl2Btn.disabled=false;

  genBtn.innerHTML='重新生成'; genBtn.disabled=false;

  // Activate global download
  checkDlAllBtn();
  const hasBadge=badgeChk&&badgeChk.checked;
  toast('批次 #'+bid+' 生成成功！'+(hasBadge?' ✦ 已叠加角标':'')+' — 点击预览图可全屏查看');

  // 生成完成后自动弹出全屏预览，方便查看效果
  setTimeout(()=>openPreviewModal(b), 300);
}

function checkDlAllBtn(){
  const anyCanvas=S.batches.some(b=>b.canvas);
  const dlAllBtn=document.getElementById('dlAllBtn');
  if(dlAllBtn) dlAllBtn.disabled=!anyCanvas;
}

function downloadBatch(bid){
  const b=S.batches.find(x=>x.id===bid);
  if(!b||!b.canvas){ toast('请先生成拼图','err'); return; }
  const a=document.createElement('a');
  a.href=b.canvas.toDataURL('image/jpeg',0.95);
  a.download='videoframe_'+b.cols+'x'+b.rows+'_batch'+bid+'_1080p.jpg';
  a.click();
  toast('批次 #'+bid+' 已下载 1920×1080');
}

async function generateAll(){
  if(S.batches.length===0){ toast('请先添加拼图批次','err'); return; }
  const btn=document.getElementById('genAllBtn');
  btn.innerHTML='<span class="spin"></span>生成中...'; btn.disabled=true;
  let ok=0;
  for(const b of S.batches){
    if(b.cells.filter(c=>c!==null).length>0){ await generateBatch(b.id); ok++; }
  }
  btn.innerHTML='<svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" fill="none" stroke-width="2"><path d="M5 3l14 9-14 9V3z"/></svg>一键生成全部';
  btn.disabled=false;
  if(ok===0) toast('所有批次均无填充图像','err');
  else toast('一键生成完成，共 '+ok+' 个批次');
}

function downloadAll(){
  const ready=S.batches.filter(b=>b.canvas);
  if(ready.length===0){ toast('请先生成拼图','err'); return; }
  ready.forEach((b,i)=>{ setTimeout(()=>downloadBatch(b.id), i*300); });
  toast('正在下载全部 '+ready.length+' 个拼图...');
}

function loadImg(src){
  if(S.imgCache.has(src)) return S.imgCache.get(src);
  const p = new Promise(r=>{
    const img=new Image(); img.onload=()=>r(img); img.onerror=()=>r(null); img.src=src;
  });
  S.imgCache.set(src, p);
  return p;
}

// ===================================================================
// FULL PREVIEW MODAL
// ===================================================================
let pmCurrentBatch=null;
function openPreviewModal(b){
  if(!b.canvas) return;
  pmCurrentBatch=b;
  const modal=document.getElementById('previewModal');
  const pmCanvas=document.getElementById('pmCanvas');
  document.getElementById('pmTitle').textContent=b.cols+'×'+b.rows+' 批次 #'+b.id+' 预览';
  // Scale canvas to fit screen
  const maxW=window.innerWidth-40;
  const maxH=window.innerHeight-80;
  const scale=Math.min(maxW/1920, maxH/1080, 1);
  pmCanvas.width=Math.round(1920*scale);
  pmCanvas.height=Math.round(1080*scale);
  pmCanvas.style.width=pmCanvas.width+'px';
  pmCanvas.style.height=pmCanvas.height+'px';
  pmCanvas.getContext('2d').drawImage(b.canvas,0,0,pmCanvas.width,pmCanvas.height);
  modal.classList.add('open');
}
function closePreviewModal(){
  document.getElementById('previewModal').classList.remove('open');
  pmCurrentBatch=null;
}
document.getElementById('pmClose').addEventListener('click', closePreviewModal);
document.getElementById('previewModal').addEventListener('click', e=>{
  if(e.target===document.getElementById('previewModal')) closePreviewModal();
});
document.getElementById('pmDlBtn').addEventListener('click', ()=>{
  if(pmCurrentBatch) downloadBatch(pmCurrentBatch.id);
});

// ===================================================================
// THUMB SIZE SLIDER
// ===================================================================
(function initThumbSlider(){
  const slider = document.getElementById('thumbSizeSlider');
  const label  = document.getElementById('thumbSizeLabel');
  const grid   = document.getElementById('fGrid');
  const btnIn  = document.getElementById('thumbZoomIn');
  const btnOut = document.getElementById('thumbZoomOut');
  const MIN=60, MAX=320, STEP=10;

  function applySize(v){
    v=Math.max(MIN,Math.min(MAX,v));
    slider.value=v; label.textContent=v+'px';
    grid.style.setProperty('--thumb-size', v+'px');
    const pct=((v-MIN)/(MAX-MIN)*100).toFixed(1)+'%';
    slider.style.setProperty('--pct', pct);
  }

  slider.addEventListener('input', ()=>applySize(parseInt(slider.value)));
  btnIn.addEventListener('click', ()=>applySize(parseInt(slider.value)+STEP));
  btnOut.addEventListener('click',()=>applySize(parseInt(slider.value)-STEP));

  grid.addEventListener('wheel', e=>{
    if(e.ctrlKey||e.metaKey){
      e.preventDefault();
      applySize(parseInt(slider.value)+(e.deltaY<0?STEP:-STEP));
    }
  },{passive:false});

  applySize(130);
})();

// ===================================================================
// LIGHTBOX
// ===================================================================
// ===================================================================
// LIGHTBOX — 重写缩放逻辑：图片以自然尺寸显示，用 CSS transform 缩放平移
// 彻底解决缩放变形问题
// ===================================================================
const LB={
  idx:0, scale:1, minScale:.05, maxScale:10,
  // panX/panY：图片中心相对于视口中心的偏移（像素，原始尺寸下）
  panX:0, panY:0,
  drag:false, dragStartX:0, dragStartY:0, dragStartPanX:0, dragStartPanY:0,
  iw:1, ih:1  // 图片自然尺寸
};
const lb        =document.getElementById('lb');
const lbImg     =document.getElementById('lbImg');
const lbViewport=document.getElementById('lbViewport');
const lbStrip   =document.getElementById('lbStrip');

function openLightbox(frameIdx){
  if(S.frames.length===0) return;
  LB.idx=Math.max(0,Math.min(frameIdx,S.frames.length-1));
  lb.classList.add('open'); lb.focus();
  buildStrip(); showFrame(LB.idx,true);
}
function closeLightbox(){ lb.classList.remove('open'); lbImg.src=''; }
function buildStrip(){
  lbStrip.innerHTML='';
  const total = S.frames.length;
  const CHUNK = 180;
  let offset = 0;
  function appendChunk(){
    const end = Math.min(offset + CHUNK, total);
    const frag = document.createDocumentFragment();
    for(let i=offset;i<end;i++){
      const f=S.frames[i];
      const el=document.createElement('div');
      el.className='lb-strip-item'+(i===LB.idx?' active':'');
      el.dataset.fi=i;
      el.innerHTML='<img src="'+f.dataUrl+'" loading="lazy"/>';
      el.addEventListener('click',()=>showFrame(i,true));
      frag.appendChild(el);
    }
    lbStrip.appendChild(frag);
    offset = end;
    if(offset<total){
      if('requestIdleCallback' in window) window.requestIdleCallback(appendChunk);
      else setTimeout(appendChunk, 0);
    }
  }
  appendChunk();
}
function showFrame(i,resetZoom){
  LB.idx=Math.max(0,Math.min(i,S.frames.length-1));
  const f=S.frames[LB.idx];
  lbImg.src=f.dataUrl;
  document.getElementById('lbTitle').textContent='帧 #'+(LB.idx+1);
  document.getElementById('lbSub').textContent=f.time.toFixed(2)+'s · '+(LB.idx+1)+' / '+S.frames.length;
  const prevActive = lbStrip.querySelector('.lb-strip-item.active');
  if(prevActive) prevActive.classList.remove('active');
  const active = lbStrip.querySelector('.lb-strip-item[data-fi="'+LB.idx+'"]');
  if(active){
    active.classList.add('active');
    active.scrollIntoView({block:'nearest',inline:'center',behavior:'smooth'});
  }
  document.getElementById('lbPrev').classList.toggle('hidden',LB.idx===0);
  document.getElementById('lbNext').classList.toggle('hidden',LB.idx===S.frames.length-1);
  if(resetZoom){
    const doFit=()=>{ LB.iw=lbImg.naturalWidth||1; LB.ih=lbImg.naturalHeight||1; fitToView(false); };
    if(lbImg.complete && lbImg.naturalWidth>0) doFit();
    else lbImg.onload=doFit;
  } else {
    applyTransform(false);
  }
}

function getViewportMetrics(){
  const vw = lbViewport.clientWidth || window.innerWidth || 1;
  const rawH = (lbViewport.clientHeight || window.innerHeight || 1) - 72;
  const vh = Math.max(1, rawH);
  return { vw, vh };
}

// fitToView: 自适应缩放，图片完整显示在视口内
function fitToView(anim){
  const { vw, vh } = getViewportMetrics();
  LB.iw=lbImg.naturalWidth||LB.iw||1;
  LB.ih=lbImg.naturalHeight||LB.ih||1;
  LB.scale=Math.min(vw/LB.iw, vh/LB.ih, 1);
  LB.panX=0; LB.panY=0;  // 居中
  // 设置图片自然尺寸，让transform-origin:center center正确工作
  lbImg.style.width=LB.iw+'px';
  lbImg.style.height=LB.ih+'px';
  // 将图片定位到视口中心
  lbImg.style.left=((vw-LB.iw)/2)+'px';
  lbImg.style.top=((vh-LB.ih)/2)+'px';
  applyTransform(anim);
}

// applyTransform: 只负责 scale 和 pan，不改变基础定位
function applyTransform(anim){
  if(anim){ lbImg.classList.add('anim'); setTimeout(()=>lbImg.classList.remove('anim'),260); }
  else lbImg.classList.remove('anim');
  lbImg.style.transform='translate('+LB.panX+'px,'+LB.panY+'px) scale('+LB.scale+')';
  document.getElementById('lbZoomVal').textContent=Math.round(LB.scale*100)+'%';
}

// zoomAt: 以视口坐标 (cx,cy) 为中心缩放
function zoomAt(cx,cy,factor){
  const newScale=Math.max(LB.minScale,Math.min(LB.maxScale,LB.scale*factor));
  if(Math.abs(newScale-LB.scale)<1e-6) return;
  // 计算图片左上角在视口中的位置
  const { vw, vh } = getViewportMetrics();
  const imgLeft=(vw-LB.iw)/2 + LB.panX - LB.iw*(LB.scale-1)/2;
  const imgTop =(vh-LB.ih)/2 + LB.panY - LB.ih*(LB.scale-1)/2;
  // 缩放前鼠标相对图片左上角的偏移
  const mx=cx-imgLeft, my=cy-imgTop;
  // 新的图片左上角位置（保持鼠标下图片像素不动）
  const newLeft=cx-mx*(newScale/LB.scale);
  const newTop =cy-my*(newScale/LB.scale);
  // 转换回 panX/panY
  LB.panX=newLeft-(vw-LB.iw)/2-LB.iw*(newScale-1)/2;
  LB.panY=newTop -(vh-LB.ih)/2-LB.ih*(newScale-1)/2;
  LB.scale=newScale;
  applyTransform(false);
}
lbViewport.addEventListener('wheel',e=>{
  e.preventDefault();
  const rect=lbViewport.getBoundingClientRect();
  zoomAt(e.clientX-rect.left, e.clientY-rect.top, e.deltaY<0?1.12:1/1.12);
},{passive:false});
lbViewport.addEventListener('mousedown',e=>{
  if(e.button!==0) return;
  LB.drag=true;
  LB.dragStartX=e.clientX; LB.dragStartY=e.clientY;
  LB.dragStartPanX=LB.panX; LB.dragStartPanY=LB.panY;
  lbViewport.classList.add('grabbing'); e.preventDefault();
});
window.addEventListener('mousemove',e=>{
  if(!LB.drag) return;
  LB.panX=LB.dragStartPanX+(e.clientX-LB.dragStartX);
  LB.panY=LB.dragStartPanY+(e.clientY-LB.dragStartY);
  applyTransform(false);
});
window.addEventListener('mouseup',()=>{ LB.drag=false; lbViewport.classList.remove('grabbing'); });
lbViewport.addEventListener('dblclick',e=>{
  const rect=lbViewport.getBoundingClientRect();
  const cx=e.clientX-rect.left, cy=e.clientY-rect.top;
  LB.scale<1.5 ? zoomAt(cx,cy,2/LB.scale) : fitToView(true);
});
// touch
let lastTouches=null, lastPinchDist=null;
lbViewport.addEventListener('touchstart',e=>{
  lastTouches=e.touches;
  if(e.touches.length===2){
    const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY;
    lastPinchDist=Math.hypot(dx,dy);
  } else if(e.touches.length===1){
    LB.drag=true; LB.dragStartX=e.touches[0].clientX; LB.dragStartY=e.touches[0].clientY;
    LB.dragStartPanX=LB.panX; LB.dragStartPanY=LB.panY;
  }
  e.preventDefault();
},{passive:false});
lbViewport.addEventListener('touchmove',e=>{
  if(e.touches.length===2&&lastPinchDist!==null){
    const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY;
    const dist=Math.hypot(dx,dy);
    const rect=lbViewport.getBoundingClientRect();
    const cx=((e.touches[0].clientX+e.touches[1].clientX)/2)-rect.left;
    const cy=((e.touches[0].clientY+e.touches[1].clientY)/2)-rect.top;
    zoomAt(cx,cy,dist/lastPinchDist); lastPinchDist=dist;
  } else if(e.touches.length===1&&LB.drag){
    LB.panX=LB.dragStartPanX+(e.touches[0].clientX-LB.dragStartX);
    LB.panY=LB.dragStartPanY+(e.touches[0].clientY-LB.dragStartY);
    applyTransform(false);
  }
  e.preventDefault();
},{passive:false});
lbViewport.addEventListener('touchend',e=>{
  if(e.touches.length<2) lastPinchDist=null;
  if(e.touches.length===0) LB.drag=false;
});
lb.addEventListener('keydown',e=>{
  if(e.key==='ArrowLeft'||e.key==='a'||e.key==='A') showFrame(LB.idx-1,true);
  if(e.key==='ArrowRight'||e.key==='d'||e.key==='D') showFrame(LB.idx+1,true);
  if(e.key==='Escape') closeLightbox();
  if(e.key==='+'||e.key==='='){
    const { vw, vh } = getViewportMetrics();
    zoomAt(vw/2,vh/2,1.2);
  }
  if(e.key==='-'){
    const { vw, vh } = getViewportMetrics();
    zoomAt(vw/2,vh/2,1/1.2);
  }
  if(e.key==='0'||e.key==='f'||e.key==='F') fitToView(true);
  if(e.key==='1'){
    // 100%原始大小，居中
    LB.scale=1; LB.panX=0; LB.panY=0;
    lbImg.style.width=LB.iw+'px'; lbImg.style.height=LB.ih+'px';
    const { vw, vh } = getViewportMetrics();
    lbImg.style.left=((vw-LB.iw)/2)+'px'; lbImg.style.top=((vh-LB.ih)/2)+'px';
    applyTransform(true);
  }
});
document.getElementById('lbClose').addEventListener('click', closeLightbox);
document.getElementById('lbPrev').addEventListener('click',()=>showFrame(LB.idx-1,true));
document.getElementById('lbNext').addEventListener('click',()=>showFrame(LB.idx+1,true));
document.getElementById('lbBtnZoomIn').addEventListener('click',()=>{
  const { vw, vh } = getViewportMetrics();
  zoomAt(vw/2,vh/2,1.5);
});
document.getElementById('lbBtnZoomOut').addEventListener('click',()=>{
  const { vw, vh } = getViewportMetrics();
  zoomAt(vw/2,vh/2,1/1.5);
});
document.getElementById('lbBtnFit').addEventListener('click',()=>fitToView(true));
document.getElementById('lbBtnOrig').addEventListener('click',()=>{
  LB.scale=1; LB.panX=0; LB.panY=0;
  lbImg.style.width=LB.iw+'px'; lbImg.style.height=LB.ih+'px';
  const { vw, vh } = getViewportMetrics();
  lbImg.style.left=((vw-LB.iw)/2)+'px'; lbImg.style.top=((vh-LB.ih)/2)+'px';
  applyTransform(true);
});
document.getElementById('lbBtnDl').addEventListener('click',()=>downloadFrame(LB.idx));
document.getElementById('lbzIn').addEventListener('click',()=>{
  const { vw, vh } = getViewportMetrics();
  zoomAt(vw/2,vh/2,1.3);
});
document.getElementById('lbzOut').addEventListener('click',()=>{
  const { vw, vh } = getViewportMetrics();
  zoomAt(vw/2,vh/2,1/1.3);
});
document.getElementById('lbzReset').addEventListener('click',()=>fitToView(true));
lb.addEventListener('click',e=>{ if(e.target===lb) closeLightbox(); });

// ===================================================================
// GLOBAL KEYBOARD SHORTCUTS
// ===================================================================
document.addEventListener('keydown', e=>{
  // 帮助浮层打开时：? 或 Esc 关闭，其余拦截
  const helpO = document.getElementById('helpOverlay');
  if(helpO && helpO.classList.contains('open')){
    if(e.key==='Escape'||e.key==='?') closeHelp();
    return;
  }
  // skip if in input/textarea or lightbox/modal is open
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.tagName==='SELECT') return;
  // ? 打开帮助（不受其它面板限制）
  if(e.key==='?'){ e.preventDefault(); openHelp(); return; }
  if(lb.classList.contains('open')) return;
  if(document.getElementById('previewModal').classList.contains('open')){
    if(e.key==='Escape') closePreviewModal();
    return;
  }
  if(document.getElementById('framePicker')) return;

  // 撤销 / 重做
  if((e.ctrlKey||e.metaKey)&&(e.key==='z'||e.key==='Z')&&!e.shiftKey){ e.preventDefault(); if(typeof undo==='function') undo(); return; }
  if((e.ctrlKey||e.metaKey)&&((e.key==='y'||e.key==='Y')||((e.key==='z'||e.key==='Z')&&e.shiftKey))){ e.preventDefault(); if(typeof redo==='function') redo(); return; }

  if(e.key==='a'||e.key==='A'){
    S.selected=S.frames.map((_,i)=>i);
    renderSel(); updateSelBadge(); updateFillBtn(); updateDlBtns(); updateQuickBar();
    toast('已全选 '+S.frames.length+' 帧');
  }
  if(e.key==='d'||e.key==='D'){
    S.selected=[]; renderSel(); updateSelBadge(); updateFillBtn(); updateDlBtns(); updateQuickBar();
  }
  if(e.key==='1') switchTab(0);
  if(e.key==='2') switchTab(1);
  if(e.key==='3') switchTab(2);
  if(e.key==='r'||e.key==='R') doCapture();
  if(e.key==='q'||e.key==='Q') runSmartFlow();
  if(e.key==='g'||e.key==='G') generateAll();
  if((e.ctrlKey||e.metaKey)&&(e.key==='s'||e.key==='S')){
    e.preventDefault(); downloadAll();
  }
  if(e.key==='Escape'){
    S.selected=[]; renderSel(); updateSelBadge(); updateFillBtn(); updateDlBtns(); updateQuickBar();
  }
});

// ===================================================================
// INITIAL DEFAULT BATCHES
// ===================================================================
addBatch(2,2);
addBatch(3,3);
</script>
</body>
</html>
